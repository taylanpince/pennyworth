# Copy to .env and adjust. Paths are on the host.

# Host user that owns the vault/transcripts (id -u / id -g).
PUID=1000
PGID=100

# Directory with secret files (0700 dir, 0600 files). Never inside the repo.
PENNYWORTH_SECRETS_DIR=/home/USER/.config/pennyworth

# Persistent state (Paperclip DB/workspaces, ops-mcp SQLite).
PENNYWORTH_DATA_DIR=./data

# Local transcripts (mounted read-only into ops-mcp only).
TRANSCRIPTS_DIR=/home/USER/Documents/transcripts

# Obsidian vault and the vault folders ops-mcp may see (comma-separated, vault-relative).
# Only these folders are mounted, read-write, into ops-mcp. Nothing is mounted into Paperclip.
VAULT_DIR=/home/USER/obsidian/vault
VAULT_FOLDERS=Meetings

# Set to true after you have created your Paperclip account.
PAPERCLIP_DISABLE_SIGN_UP=false

GOOGLE_CALENDAR_ID=primary

# Include the generated vault mounts automatically.
COMPOSE_FILE=compose.yaml:compose.vault.yaml

# Testing only: serve fixtures/ instead of Google (unset for real Calendar/Drive).
# GOOGLE_FIXTURES_DIR=/fixtures

# Slack MCP OAuth client (a public client ID registered for your Slack workspace; no secret). See README › Slack.
SLACK_CLIENT_ID=

# Telegram (telegram-mcp, D-27): your organization's Telegram MCP endpoint (per-user session, chat
# allowlist, OAuth with dynamic client registration). Leave empty to skip Telegram.
TELEGRAM_MCP_URL=
# Who you are, comma-separated. Messages carry only a display name
# and mentions are plain text. Names are display-name prefixes of your own messages, handles are
# usernames without "@", aliases are words people call you in text (matched as whole words).
TELEGRAM_ME_NAMES=Dana Whitfield
TELEGRAM_ME_HANDLES=danaw
TELEGRAM_ME_ALIASES=dana

# Board (services/board): host names it answers to. Add your tailnet name for the phone, e.g.
# BOARD_ALLOWED_HOSTS=localhost:3120,127.0.0.1:3120
# Phones on the home network (D-23): http://pennyworth.local for paired devices only. Off unless
# BOARD_LAN_CLIENTS (allowed client networks) is set; publish on the LAN with BOARD_LAN_BIND.
# BOARD_LAN_CLIENTS=192.168.1.0/24
# BOARD_LAN_BIND=0.0.0.0
# BOARD_LAN_PORT=80
# BOARD_LAN_HOSTS=pennyworth.local
# The phone anywhere over Tailscale (`tailscale serve --bg --https=443 http://127.0.0.1:80`): add the
# tailnet name to BOARD_LAN_HOSTS and 10.231.1.1/32 (tailscale serve arrives from the egress gateway)
# to BOARD_LAN_CLIENTS, and point pairing links at it.
# BOARD_LAN_URL=https://<machine>.<tailnet>.ts.net
