# Copy to .env and adjust. Paths are on the host.

# Host user that owns the vault/transcripts (id -u / id -g).
PUID=1000
PGID=100

# Directory with secret files (0700 dir, 0600 files). Never inside the repo.
PENNYWORTH_SECRETS_DIR=/home/USER/.config/pennyworth

# Persistent state (Paperclip DB/workspaces, ops-mcp SQLite).
PENNYWORTH_DATA_DIR=./data

# Local transcripts (mounted read-only into ops-mcp only).
TRANSCRIPTS_DIR=/home/USER/Documents/transcripts

# Obsidian vault and the vault folders ops-mcp may see (comma-separated, vault-relative).
# Only these folders are mounted, read-write, into ops-mcp. Nothing is mounted into Paperclip.
VAULT_DIR=/home/USER/obsidian/vault
VAULT_FOLDERS=Meetings

# Reference documentation the Assistant may read, as name=/host/path pairs (comma-separated),
# mounted read-only into ops-mcp. Folders of .md files; an agent skill in .agents/skills/<name>/
# describes what each covers. Re-run scripts/bootstrap.sh after changing this. Example:
# KNOWLEDGE_BASES=aggbrain=/home/USER/.claude/plugins/marketplaces/aggbrain,wallet-brain=/home/USER/.claude/plugins/marketplaces/wallet-brain
KNOWLEDGE_BASES=

# Set to true after you have created your Paperclip account.
PAPERCLIP_DISABLE_SIGN_UP=false

GOOGLE_CALENDAR_ID=primary

# Include the generated vault mounts automatically.
COMPOSE_FILE=compose.yaml:compose.vault.yaml

# Testing only: serve fixtures/ instead of Google (unset for real Calendar/Drive).
# GOOGLE_FIXTURES_DIR=/fixtures

# Slack MCP OAuth client (a public client ID registered for your Slack workspace; no secret). See README › Slack.
SLACK_CLIENT_ID=

# Telegram (telegram-mcp, D-37): your own session, read-only. Set up in README › Telegram (an app at
# my.telegram.org, then sign in from the board). Words people call you in text, comma-separated
# (@mentions and replies to you are Telegram's own flags):
TELEGRAM_ME_ALIASES=dana
# Chats Pennyworth never reads: chat refs (tg:…) or exact titles, ";"-separated. Muted and archived
# chats are left out unless these are true.
TELEGRAM_EXCLUDE=
# TELEGRAM_INCLUDE_MUTED=false
# TELEGRAM_INCLUDE_ARCHIVED=false

# Primer (primer-mcp, D-31): your organization's Primer MCP endpoint, e.g. https://primer.example.com/mcp
# (OAuth with dynamic client registration; run scripts/primer-auth.sh once). Leave empty to skip Primer.
PRIMER_MCP_URL=

# Glean (glean-mcp, D-38): your organization's Glean MCP server URL, from Glean's MCP Configurator
# (app.glean.com/settings/connected-apps, "Custom" host), e.g. https://acme-be.glean.com/mcp/default.
# Sign in with Connect on the board. Leave empty to skip Glean.
GLEAN_MCP_URL=

# Grafana (grafana-mcp): your Grafana Cloud stack, e.g. https://acme.grafana.net, read by the runner's
# Engineer jobs through Grafana's hosted MCP server (GRAFANA_MCP_URL, default https://mcp.grafana.com/mcp).
# Sign in with Connect on the board (read and query scopes only). Leave empty to skip Grafana.
GRAFANA_URL=
GRAFANA_MCP_URL=

# GitHub (github-mcp, D-39): the Assistant reads issues and pull requests with your gh token (run
# scripts/github-auth.sh), and comments or opens issues (D-42), when you ask, only in these organizations (comma-separated).
GITHUB_COMMENT_ORGS=

# Board (services/board): host names it answers to. Add your tailnet name for the phone, e.g.
# BOARD_ALLOWED_HOSTS=localhost:3120,127.0.0.1:3120
# Phones on the home network (D-23): http://pennyworth.local for paired devices only. Off unless
# BOARD_LAN_CLIENTS (allowed client networks) is set; publish on the LAN with BOARD_LAN_BIND.
# BOARD_LAN_CLIENTS=192.168.1.0/24
# BOARD_LAN_BIND=0.0.0.0
# BOARD_LAN_PORT=80
# BOARD_LAN_HOSTS=pennyworth.local
# The phone anywhere over Tailscale (`tailscale serve --bg --https=443 http://127.0.0.1:80`): add the
# tailnet name to BOARD_LAN_HOSTS and 10.231.1.1/32 (tailscale serve arrives from the egress gateway)
# to BOARD_LAN_CLIENTS, and point pairing links at it.
# BOARD_LAN_URL=https://<machine>.<tailnet>.ts.net
